# Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service role key. Server-side only.
#
# This key bypasses Row Level Security. schema.sql disables RLS deliberately
# for the POC, which means this key is the only thing standing between the
# public internet and the whole dataset. Never expose it to a browser, never
# commit it, and never put it in a NEXT_PUBLIC_/VITE_ style variable.
SUPABASE_SERVICE_ROLE_KEY=

# API key ----------------------------------------------------------------
# Shared key for /api/*. Sent by callers as `Authorization: Bearer <key>`.
#
# Fails closed: leaving this empty does NOT open the API, it rejects every
# request to /api/* with 401. The HTML pages and /health stay open either way.
#
# Generate one with: openssl rand -hex 32
API_KEY=

# Local server ------------------------------------------------------------
# Only used by `npm start` / `npm run dev`. Vercel sets its own port.
PORT=3000

# Telemetry ---------------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry entirely. The
# app then behaves exactly as it did before instrumentation was added.
#
# Signals go to an OpenTelemetry Collector, which processes them and forwards
# to SigNoz. The app never talks to SigNoz directly.
#
# Collector:        https://<collector-host>:4318
# Local collector:  http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# The bare token, without a scheme. Sent as `Authorization: Bearer <token>` on
# every OTLP export. Leave empty for a collector that needs no auth.
OTEL_AUTH_TOKEN=

# Service name shown in SigNoz. Defaults to inventory-service.
OTEL_SERVICE_NAME=inventory-service
