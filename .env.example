# Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service role key. Server-side only.
#
# This key bypasses Row Level Security. schema.sql disables RLS deliberately
# for the POC, which means this key is the only thing standing between the
# public internet and the whole dataset. Never expose it to a browser, never
# commit it, and never put it in a NEXT_PUBLIC_/VITE_ style variable.
SUPABASE_SERVICE_ROLE_KEY=

# Local server ------------------------------------------------------------
# Only used by `npm start` / `npm run dev`. Vercel sets its own port.
PORT=3000

# Telemetry ---------------------------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable telemetry entirely. The
# app then behaves exactly as it did before instrumentation was added.
#
# SigNoz Cloud:     https://ingest.<region>.signoz.cloud:443
# Self-hosted:      http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Required by SigNoz Cloud, not by a self-hosted instance.
SIGNOZ_INGESTION_KEY=

# Service name shown in SigNoz. Defaults to hospital-inventory.
OTEL_SERVICE_NAME=hospital-inventory
